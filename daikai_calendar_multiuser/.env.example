PUBLIC_BASE_URL=http://localhost:8080
KINTONE_BASE_URL=https://daikai-engineering.cybozu.com
KINTONE_OAUTH_CLIENT_ID=PASTE_KINTONE_CLIENT_ID
KINTONE_OAUTH_CLIENT_SECRET=PASTE_KINTONE_CLIENT_SECRET
GOOGLE_CLIENT_JSON=client_secret.json
FLASK_SECRET_KEY=GENERATE_A_RANDOM_HEX_KEY
TOKEN_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
DATABASE_URL=sqlite:///pilot.db

# Protected employee identity app. Both values must be explicitly supplied.
# Leaving both blank retains the original monthly-record login requirement.
KINTONE_IDENTITY_APP_ID=
KINTONE_IDENTITY_USER_FIELD=

# Enable only after approved Kintone permission changes and sandbox E2E tests.
KINTONE_CONTROLLED_DELETE_ENABLED=false
KINTONE_CONTROLLED_DELETE_PERMISSIONS_ACK=false
# Server secret: App 1675 API token with View records and Delete records only.
KINTONE_DELETE_API_TOKEN=
